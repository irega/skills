{
  "model": "haiku",
  "effortLevel": "medium",
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "rtk hook claude" }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "echo 'use caveman mode'" }]
      }
    ]
  }
}
